# Copy to .env for local Netlify Dev, or set these in the Netlify dashboard.
# NEVER commit .env to git.

# football-data.org free API key — register at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_key_here

# Supabase — found in Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here   # Keep secret — server-side only

# Tournament identifiers (defaults shown — only change for a different competition)
TOURNAMENT_CODE=WC2026
COMPETITION_CODE=WC
